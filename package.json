  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "mygo-cli": "^0.10.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
